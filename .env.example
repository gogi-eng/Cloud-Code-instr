# ===========================
# OpenClaw — API-ключи
# ===========================
# Скопируйте этот файл в ~/.openclaw/.env
# и заполните нужные ключи.
#
#   cp .env.example ~/.openclaw/.env
#   chmod 600 ~/.openclaw/.env
#
# Раскомментируйте строки для выбранного провайдера.
#
# ВАЖНО: Не задавайте здесь переменные для мессенджеров (TELEGRAM_BOT_TOKEN и др.),
# пока не добавите соответствующую секцию в openclaw.json.
# Иначе openclaw doctor будет показывать предупреждения.

# --- LLM-провайдеры (нужен хотя бы один) ---

# Anthropic (Claude) — рекомендуется
# Получить: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4)
# Получить: https://platform.openai.com
# OPENAI_API_KEY=sk-...

# DeepSeek
# Получить: https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-...

# Google Gemini
# Получить: https://aistudio.google.com
# GOOGLE_API_KEY=AIza...

# --- Эмбеддинги (для memory search, необязательно) ---
# Если не планируете использовать memory search, отключите его:
#   openclaw config set agents.defaults.memorySearch.enabled false
#
# Если хотите включить memory search, раскомментируйте один из ключей выше
# (OPENAI_API_KEY или GOOGLE_API_KEY подходят и для эмбеддингов).

# --- Мессенджеры (добавляйте только при подключении) ---

# Telegram — токен от @BotFather
# Добавьте этот ключ ПЕРЕД добавлением секции telegram в openclaw.json,
# иначе получите повторяющиеся предупреждения при запуске.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Discord — токен бота
# DISCORD_BOT_TOKEN=MTIz...

# Slack — токен приложения
# SLACK_BOT_TOKEN=xoxb-...
